{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Monitor": {
    // Arayüz girişi. Şifre verilmezse arayüze yalnızca bu makineden (localhost) erişilir; başkalarının erişebildiği bir
    // kurulumda mutlaka verin, ortam değişkeniyle: Monitor__AdminPassword
    "AdminUser": "admin",
    "AdminPassword": "",
    // Pod'ların test aralığı (sn) ve tek bağlantı denemesinin zaman aşımı (ms); pod'lara bildirim yanıtında gönderilir.
    "IntervalSeconds": 30,
    "ProbeTimeoutMs": 5000,
    // Bir pod bu kadar test aralığı boyunca bildirim göndermezse "eksik" sayılır.
    "MissingAfterCycles": 3,
    // Uyarı eşikleri: bellek limitin %90'ı, CPU throttling %25, TCP soketleri port aralığının %70'i, sertifika bitişine 14 gün;
    // yeniden başlama / OOM / IP değişikliği 60 dakika boyunca gösterilir.
    "Alerts": {
      "MemoryPercent": 90,
      "CpuThrottledPercent": 25,
      "PortsPercent": 70,
      "CertificateDays": 14,
      "RecentMinutes": 60
    },
    "DataFile": "data/definitions.json"
  }
}
