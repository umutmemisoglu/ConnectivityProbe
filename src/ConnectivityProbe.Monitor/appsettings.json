{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Monitor": {
    // Ortak erişim anahtarı: uygulamalardaki ConnectivityProbe:AccessKey ile aynı olmalı.
    // Buraya yazmak yerine ortam değişkeniyle verin: Monitor__AccessKey
    "AccessKey": "",
    "IntervalSeconds": 30,
    "ProbeTimeoutMs": 5000,
    "DataFile": "data/definitions.json",
    "MaxConcurrency": 4,
    "MaxInstanceAttempts": 60,
    "InstanceConfidence": 0.95,
    "MaxProbeCallsPerConnection": 40,
    "MissingAfterCycles": 3
  }
}
