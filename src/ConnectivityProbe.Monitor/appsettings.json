{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Monitor": {
    // Arayüz girişi. Şifre verilmezse arayüze yalnızca bu makineden (localhost) erişilir; başkalarının erişebildiği bir
    // kurulumda mutlaka verin, ortam değişkeniyle: Monitor__AdminPassword
    "AdminUser": "admin",
    "AdminPassword": "",
    // Pod'ların test aralığı (sn) ve tek bağlantı denemesinin zaman aşımı (ms); pod'lara bildirim yanıtında gönderilir.
    "IntervalSeconds": 30,
    "ProbeTimeoutMs": 5000,
    // Bir pod bu kadar test aralığı boyunca bildirim göndermezse "eksik" sayılır.
    "MissingAfterCycles": 3,
    "DataFile": "data/definitions.json"
  }
}
