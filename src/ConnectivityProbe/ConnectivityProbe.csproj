<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tek kod tabanı, hiçbir NuGet bağımlılığı yok (yalnızca .NET'in kendi HttpClient, Socket ve kriptografi parçaları).
      netstandard2.0 : .NET Core 2.0+, .NET 5 - 10, Mono
      net462         : .NET Framework 4.6.2+ (aynı kod; eski .NET Framework sürümlerinde netstandard uyumluluk DLL'leri gerekmesin diye)
  -->
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net462</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>ConnectivityProbe</RootNamespace>
    <AssemblyName>ConnectivityProbe</AssemblyName>
  </PropertyGroup>

  <!--
    NuGet paketi. Sürüm tek yerden yönetilir: yeni sürüm yayınlarken yalnızca <Version> değiştirilir (bkz. PUBLISHING.md).
    dotnet pack -c Release çıktısı: ConnectivityProbe.<sürüm>.nupkg + .snupkg (hata ayıklama sembolleri).
  -->
  <PropertyGroup>
    <PackageId>ConnectivityProbe</PackageId>
    <Version>2.0.0</Version>
    <Authors>Fatih Umut Memişoğlu</Authors>
    <Copyright>Copyright (c) 2026 Fatih Umut Memişoğlu</Copyright>
    <!-- Açık kaynak lisansı (SPDX kimliği). Tam metin: depo kökündeki LICENSE dosyası. -->
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageProjectUrl>https://github.com/umutmemisoglu/ConnectivityProbe</PackageProjectUrl>
    <RepositoryUrl>https://github.com/umutmemisoglu/ConnectivityProbe</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Title>ConnectivityProbe</Title>
    <Description>Every pod / server of your application registers itself to ConnectivityProbe Monitor with an app key, pulls its connection list, tests every connection (TCP) from inside and reports back, together with the application version, build id and Kubernetes cluster. Exact pod counts and per-pod results. One line to start, no endpoints, no dependencies. Works on .NET Core 2.0+, .NET 5-10 and .NET Framework 4.6.2+ (ASP.NET Core, IIS, workers, console apps).</Description>
    <PackageTags>connectivity;telnet;tcp;health;diagnostics;monitoring;kubernetes;pods;version</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>https://github.com/umutmemisoglu/ConnectivityProbe/blob/main/src/ConnectivityProbe/CHANGELOG.md</PackageReleaseNotes>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Tüm public üyeler belgelenmiş değil; eksik XML yorumu uyarısı paketi engellemesin. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Deterministic>true</Deterministic>
    <!-- CI build'lerinde yol bilgisinin pakete girmemesi için: dotnet pack -p:ContinuousIntegrationBuild=true -->
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="CHANGELOG.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ConnectivityProbe.Tests" />
  </ItemGroup>

  <!-- .NET Framework: HttpClient framework'ün kendi System.Net.Http'sinden gelir (NuGet paketi değil). -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net462'">
    <Reference Include="System.Net.Http" />
  </ItemGroup>

</Project>
