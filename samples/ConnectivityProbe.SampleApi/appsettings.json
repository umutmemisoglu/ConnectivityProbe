{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectivityProbe": {
    // Yalnızca yerel geliştirme için anahtarsız erişime izin veriyoruz. Gerçek ortamda bunun yerine
    // "AccessKey": "..." verin (ortam değişkeni: ConnectivityProbe__AccessKey) ve Monitor'deki tanıma aynı anahtarı girin.
    "AllowAnonymous": true,
    "Info": {
      "app": "ConnectivityProbe.SampleApi"
    }
  }
}
